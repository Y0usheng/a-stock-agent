# 本项目直接读取进程环境变量；本文件是配置清单，不自动加载。
# 默认复用官方 Codex 的 ChatGPT 登录；先运行 codex login。
ASTOCK_MODEL_ACCESS=subscription
# 可选：Codex 可执行文件绝对路径；留空时从 PATH 查找 codex。
# ASTOCK_CODEX_BIN=C:\path\to\codex.exe
ASTOCK_OPENAI_MODEL=gpt-6.1-sol
ASTOCK_REASONING_EFFORT=low
ASTOCK_SUBSCRIPTION_MAX_REQUESTS=4
ASTOCK_SUBSCRIPTION_MAX_TOKENS=40000
ASTOCK_SUBSCRIPTION_MAX_INPUT_CHARS=24000
ASTOCK_SUBSCRIPTION_TIMEOUT=120
# Windows 默认沿用系统代理；其他环境可显式设置 HTTP_PROXY / HTTPS_PROXY。
# 以下仅为显式 --model-access api 的旧入口配置，不会自动启用。
OPENAI_API_KEY=
ASTOCK_MAX_OUTPUT_TOKENS=8192
ASTOCK_MAX_MODEL_REQUESTS=40
ASTOCK_MAX_TOTAL_TOKENS=160000
ASTOCK_MAX_TURNS=24
ASTOCK_ANALYSIS_TIMEOUT=600
ASTOCK_MAX_QUOTE_AGE_DAYS=10
ASTOCK_PROMPT_VERSION=manager-v1
ASTOCK_OPENAI_TRACING=0
